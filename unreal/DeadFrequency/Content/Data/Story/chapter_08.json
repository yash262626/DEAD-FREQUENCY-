    },
    {
     "command": "line",
     "args": [
      "EVELYN (BRIEFING, 1996)",
      "HELIX-9 sits on the thinnest point of that shelf on this continent. With the array, we hear the past. With the Aperture, we believe we can hear the future."
     ],
     "vo": "evelyn_49b979bf01"
    },
