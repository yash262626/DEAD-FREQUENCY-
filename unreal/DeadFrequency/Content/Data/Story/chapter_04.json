     "vo": "daniel_400a850d9c"
    }
   ]
  },
  {
   "steps": [
    {
     "command": "line",
     "args": [
      "MIRA (96.1 MHz)",
      "—anyone. If anyone can hear this. This is Mira Solace, signals, HELIX-9. Please."
