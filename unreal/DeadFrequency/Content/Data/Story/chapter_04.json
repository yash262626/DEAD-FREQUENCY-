  },
  {
   "symbol": "t",
   "kind": "note",
   "props": {
    "text": "M —\n\nIf you ever need me and you can't find me: 96.1. I leave a set on it, always, by the bed.\n\nIf it isn't my voice, you'll know. You always know.\n\n— E.\n\n(Underneath, in different handwriting:)\n96.1. She never answers any more.",
    "title": "Note on Mira's mirror"
   },
