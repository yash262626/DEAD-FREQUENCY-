  {
   "symbol": "a",
   "kind": "note",
   "props": {
    "text": "MEDICAL RECEPTION — 16/17 OCT 1998\n\n22:40  Okafor, T. — headache, ringing in both ears. Third time this week. Sent back to work. (Lind)\n00:15  Pell, J. — says he heard his own voice in the records stacks. Sedative declined.\n01:20  Dr. Voss brought D. in for the hearing assessment again. D. asleep. Mira stayed with him.\n02:30  Brandt, P. — 'everyone's talking in the walls'. Lind on her way.\n02:43  —",
    "title": "Reception — night log"
   },
   "sequence": -1,
   "lines": -1
  },
