     "vo": "daniel_fd8b5e12ff"
    },
    {
     "command": "line",
     "args": [
      "KESSLER (UPLINK)",
      "Danny, you've been gone nine days."
     ],
     "vo": "kessler_72e92a6f34"
    },
    {
     "command": "wait",
     "args": [
      "1.5"
     ]
    },
    {
     "command": "line",
     "args": [
      "DANIEL",
      "...No."
     ],
     "vo": "daniel_dd67a07d93"
    },
    {
     "command": "line",
     "args": [
      "KESSLER (UPLINK)",
      "Your truck's at the gate under a foot of snow. We sent a team in on day three. The blast door is welded shut, Danny. Rusted shut. Nobody's been through that door since the nineties."
     ],
     "vo": "kessler_312bdef6dd"
    },
    {
     "command": "line",
     "args": [
      "DANIEL",
      "I walked through it. It was standing open. I walked through it."
     ],
     "vo": "daniel_c6d32ac71a"
    },
    {
     "command": "line",
     "args": [
      "KESSLER (UPLINK)",
