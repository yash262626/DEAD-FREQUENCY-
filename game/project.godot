; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=4

[application]

config/name="DEAD FREQUENCY"
config/description="Psychological horror. A radio that hears the past. Something that hears you."
run/main_scene="res://scenes/Main.tscn"
boot_splash/show_image=false
boot_splash/bg_color=Color( 0, 0, 0, 1 )
config/icon="res://icon.png"
config/version="0.9.0"

[autoload]

G="*res://scripts/g.gd"
Snd="*res://scripts/snd.gd"
Story="*res://data/story.gd"
Mats="*res://scripts/mats.gd"

[display]

window/size/width=1280
window/size/height=720
window/stretch/mode="2d"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PoolStringArray( "res://addons/df_tools/plugin.cfg" )

[rendering]

vram_compression/import_etc2=false
quality/directional_shadow/size=2048
quality/shadows/filter_mode=2
quality/filters/anisotropic_filter_level=16
quality/subsurface_scattering/quality=2
quality/subsurface_scattering/follow_surface=true
environment/default_clear_color=Color( 0, 0, 0, 1 )
quality/filters/msaa=2
